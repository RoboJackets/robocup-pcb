	)
	(text "Input voltage range:\n0 - 250V (max)\n\nR1 = 240k\nR2 = 1.96k\n\n(R2 * 250)/(R1 + R2)\n≈ 2.025 V\n\nRP2040 ADC has 2048 taps\nLSB ≈ 0.001611 V (ideal)\n\n250/(2.025/0.001611)\n≈ 0.1988 V (HV) / LSB"
		(exclude_from_sim no)
		(at 251.46 109.728 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "67c9e6bf-6e48-4157-9634-b747d4e06945")
	)
