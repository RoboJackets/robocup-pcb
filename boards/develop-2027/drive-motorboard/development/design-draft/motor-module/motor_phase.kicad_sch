	)
	(text "Derivations:\nR_{P} = 2R_{I}\nG_{V/V} = R_{F}/R_{I}\nG_{V/A} = R_{SHUNT}G_{V/V}\nI_{RANGE} = 3.3V / 2G_{V/A}"
		(exclude_from_sim no)
		(at 242.824 122.428 0)
