	(text "Differential Amplifier Specifications:\n\nGain = 27.36 V/V\nCurrent sensing gain = 136.8 mV/A @ R_{shunt} = 5 mOhm\nCurrent sensing range = ±12.06 A (rail to rail)\nOutput offset = 1.65 V\nLow pass cut-off frequency: 1.59 MHz\n\nUsing 12-bit ADC:\nCurrent sensing resolution: 11.84 mA/LSB"
		(exclude_from_sim no)
		(at 171.958 131.826 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
