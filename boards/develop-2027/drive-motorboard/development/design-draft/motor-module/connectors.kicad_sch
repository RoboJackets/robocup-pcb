	)
	(text "Overcurrent Protection:\n\nWe assume overcurrent events will occur due to stall (40A) or failure\nof MOSFETs (>40A). All downstream parts should handle at 40A for at least 3s.\nIn the event of a stall, firmware must rectify the issue within 100ms.\nIf firmware fails, the fuse will blow to protect external power supply."
		(exclude_from_sim no)
		(at 20.066 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "df00f61a-2a9c-4364-beb3-f9e30fab1cb9")
	)
