	(text "@ 20A - >100s\n@ 30A - 20s\n@ 40A - 1s\n@ 50A - 200ms\n@ 60A - 70ms\n@ 70A - 25ms"
		(exclude_from_sim no)
		(at 48.006 38.862 0)
		(effects
