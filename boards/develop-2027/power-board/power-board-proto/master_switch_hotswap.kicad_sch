		(uuid "3e979624-ad90-40c3-98e4-bcaf7ffbc33a")
	)
	(text_box "P_{ILIM} < (150°C - 25°C) / (0.8°C / W) = 156 W\nFor a 1ms transient @ 20V V_{DS}, I_{D (max}} = 8 A\nP_{ILIM} = 150 W sets transient I_{D} @ 20V V_{DS} = 7.5 A\nV_{PROG} = (150 W) / (10 * 33 A) = 0.455 V\nR_{1} / R_{2} ≈ 0.788\nR_{1} = 41.2k\nR_{2} = 5.23k"
		(exclude_from_sim no)
		(at 63.5 139.7 0)
		(size 63.5 16.51)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
