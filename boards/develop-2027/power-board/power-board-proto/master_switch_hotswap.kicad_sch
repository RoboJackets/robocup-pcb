	(text "Q1 drop-in alternates (PG-TDSON-8, S1-3 G4 D5-8, ≤ 3.3 m):\nSOA @ 21 V, 0.4 ms worst-case trip (need 4.8 A, 6.2 A w/ margin), ΔT at 20 A:\n  BSC028N06NS   2.8 mO, 60 V ~8 A, ΔT +87 K (~45k in stock as of 10/27)\n  BSC016N06NSATMA1 1.6mO, 60V, 10A, ΔT +41 K (~24k in stock as of 10/27)\n  BSC018N04LSGATMA1 1.8mO, 40V, >>10A, ΔT +44 K\n  \n    "
		(exclude_from_sim no)
		(at 87.63 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "085ffa73-7add-4cb8-b4e9-90ec25c3c6e5")
	)
	(text "V_DS 60 V\nR_DS(on) 1.45 mΩ\nI_D 180 A (at 100°C)"
		(exclude_from_sim no)
		(at 170.18 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify bottom)
		)
		(uuid "3c6bafc5-19d7-4cb9-b7f0-221534697a6c")
	)
	(text "Fault timer (C78):\nt = C x 4 V / I_TIMER\n= 1n x 4 V / 25 uA\n≈ 0.32 ms typ\n(while in current or power limit)"
		(exclude_from_sim no)
		(at 176.022 136.398 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "42b2d0fb-8419-42d8-8c67-1e6cf6d81014")
	)
	(text "21V in (max)"
		(exclude_from_sim no)
		(at 71.12 69.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4b6269f5-560a-4115-a5e2-01f08e2c2a47")
	)
	(text "External TVS, clamp @ 35.5 V"
		(exclude_from_sim no)
		(at 63.5 76.2 0)
		(effects
