				(size 1.27 1.27)
			)
		)
		(uuid "651f402a-a58e-4396-9602-db2f89fe37c0")
	)
	(text "Figuring out max Rds (on)\nAssuming a max temperature change of (max - ambient) = ~140 - 40 = 100K\nfor BSC018N04LSG, junction to ambient thermal resistance is 50K/W\nFor 100k temp rise, looking at 2W power dissipation\nP = I^2 * R -> R(hot) = P/I^2\nR (hot) = 2W/400 = 5m\nRds(on) * ~1.5 = R(hot)\nRds(on) = 5/1.5 = ~3.33m\n\nin general, for PTC MOSFETS:\nRds(hot) = (T_max - T_ambient)/(R_thja * I^2)\nRds(on) = R(hot) / ~1.5\n"
		(exclude_from_sim no)
		(at 220.98 27.432 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "67b40f39-396b-4b2b-a7b8-d1e238e01b4d")
	)
	(text "Effective 1.5m"
		(exclude_from_sim no)
		(at 127 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7c33c3af-adaf-44e6-a96d-4bae7761ef7e")
	)
	(text "TPS2491 will begin regulating MOSFET\ngate at 50 mV drop. This shunt sets\nthis threshold at 33A.\nI_{LIM} = 33A"
		(exclude_from_sim no)
		(at 127 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9931ed58-9233-4245-844e-b33d5027eff7")
	)
	(text "4V Reference"
		(exclude_from_sim no)
		(at 138.43 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "ed0c85e0-446d-4dc4-9a07-c270b1b7dc54")
	)
	(text_box "Design Requirements:\n\n25 V\n20 A typical load\n30 A worst-case transient"
		(exclude_from_sim no)
