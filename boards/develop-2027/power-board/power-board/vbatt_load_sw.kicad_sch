	)
	(text "Near MOSFET"
		(exclude_from_sim no)
		(at 254 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f7c6af5c-2b82-4872-a8b2-6427fa6f0b6e")
	)
	(text_box "P_{ILIM} < (150°C - 25°C) / (0.8°C / W) = 156 W\nFor a 100 us transient @ 25V V_{DS}, I_{D (max}} = 80 A\nFor a 1 ms transient @ 25V V_{DS}, I_{D (max}} = 5 A\nP_{ILIM} = 150 W sets transient I_{D} @ 25V V_{DS} = 6 A\nV_{PROG} = (150 W) / (10 * 33 A) = 0.455 V\n\nEnsure max transient time <1 ms\n\nR_{1} / R_{2} ≈ 0.788\nR_{1} = 41.2k\nR_{2} = 5.23k\n\nTPS2491DGS Datasheet section 8.2.2.3"
		(exclude_from_sim no)
		(at 19.05 152.4 0)
		(size 63.5 33.02)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "24d32177-9883-48a3-b33e-64097f509777")
	)
	(text_box "Downstream bulk capacitance is significant, up to 200u * 5 = 1m.\nSet I_{CHARGE} = 5 A\ndt = (1 mF * 25 V) / (5 A) = 5 ms\nC_{G} = (22 uA * (5 ms / 25 V)) - C_{RS}\n\nC_{RS} is charge inside Miller plateu\nC_{RS} = Q_{GD} / V_{plateau} = 16 nC / 4.3 V = 3.7 nF (typ)\n\nC_{G} = 4.4 nF - 3.7 nF = 0.7 nF\n\nSetting C_{G} = 1 nF increases charge time >5 ms and lowers charge current <5 A\n\nTPS2491DGS Datasheet section 8.1.1.1"
		(exclude_from_sim no)
		(at 215.9 114.3 0)
		(size 63.5 35.56)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "319f3405-3cc5-40dd-984f-65e88a83df12")
	)
	(text_box "Fault Timer\nt = C_{T} * 4 V / I_{TIMER}\n= 1 nF * 4 V / 25 uA\n= 0.16 ms\n(maximum current/power transient)"
		(exclude_from_sim no)
		(at 157.48 146.05 0)
		(size 38.1 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "42b82464-3423-41fd-aa2b-fe2616e5fd6e")
	)
	(text_box "RP2350 GPIO pins are (weakly) pulled low under reset. Even so, we want an external pull-down to not rely on this behavior"
		(exclude_from_sim no)
		(at 12.7 129.54 0)
		(size 38.1 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
