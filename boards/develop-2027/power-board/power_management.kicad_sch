	(text "From datasheet:\nR_{_FB_H} = (R_{_FB_L}(V_{OUT} - V_{FB})) / V_{FB}\n\"Where V_{FB} is 0.6 V for the SiC43X.\"\n\n= 10000*(12-0.6)/0.6 = 190kΩ"
		(exclude_from_sim no)
		(at 155.702 164.084 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "9d38846f-054c-494c-a753-fa96a96f02eb")
	)
	(text "five 22µF parts at 12V bias give roughly 55µF effective"
		(exclude_from_sim no)
		(at 162.56 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ac1071bf-f175-4b7c-9e66-0107df3752eb")
	)
	(text "requirements: (shunt voltage drop) * (gain) = 3V (under max ADC in of 3.3V);\ngain of the quad amp is 100; 3V / 100 = 0.03 V max shunt drop.\n3V3 and 5V rails are 3A: 0.03 V / 3A = 0.01Ω = 10mΩ; 12V rail is 12A: 0.03V / 12A = 0.0025 = 2.5mΩ.\nshunt rating requirement: 3V3 and 5V rails: 0.03V * 3A = 0.09W; 12V rail: 0.03V * 12A = 0.36W. (plus margin for safety)"
		(exclude_from_sim no)
		(at 231.394 27.432 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "acf0f59d-2550-4281-8b28-edc622e37277")
	)
