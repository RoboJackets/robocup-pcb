  (text "IMU U11 LSM6DSV320X: I2C (0x6A), INT1/INT2 INTERRUPTS"
    (at 134.62 83.82 0)
    (effects (font (size 2 2) (thickness 0.4) (bold yes) (color 0 0 132 1)) (justify left bottom))
    (uuid "09929034-6f46-4f9d-906e-846a4137dee8")
  )
  (text "ROUTING - IMU\nC48 (VDDIO pin 5), C49 (VDD pin 8): 100nF,\nas close to the pins as possible.\nCS to VDDIO = I2C. TA0, SDx, SCx to GND:\naddress 0x6A, mode 1 (DS14623 Fig. 27).\nOCS_aux/SDO_aux open. No traces or vias\nunder the package."
    (at 189.23 154.94 0)
    (effects (font (size 1.27 1.27) (bold yes) (color 255 0 0 1)) (justify left bottom))
    (uuid "04132a4f-1a76-44c1-b20c-46fc39b78d4f")
  )
