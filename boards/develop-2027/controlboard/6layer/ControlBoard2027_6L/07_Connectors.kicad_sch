	(text "I2C: J10 KICKER (SIGNALS ONLY), J11/J12 EXPANSION VIA F3/F4"
		(at 158.75 72.39 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "211e78e7-6b67-401e-a613-f9dfe8dca8a1")
	)
	(text "F3 -> J11, F4 -> J12: independent PTC 5V rails, 2 pins each.\nJ10 carries no power: the kicker board is fed by the powerboard.\n0.75A PTCs hold 0.55A each at 50C; NOT a combined budget.\nShared U8/source limits still apply; selectivity not guaranteed.\nAny device holding SCL/SDA low stalls the shared bus."
		(at 160.02 132.08 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "46dcac27-9294-41c9-b560-62fbb79d3aba")
	)
	(text "MOUNTING HOLES: H1-H4 BOARD M3, H5-H8 RADIO M2.5"
		(at 306.07 223.52 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "90cc889c-07bc-43de-a21a-6dc6e5ee841c")
	)
	(text "OLED: J13 SOCKET, 0.96in SSD1306"
		(at 341.63 179.07 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a5441814-1be7-423b-b10e-5de93ce2cd37")
	)
	(text "I2C ESD: U16 AT J12, U17 AT J10"
		(at 447.04 143.51 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "68e9fc45-9f52-420b-84c8-041ce4f567e7")
	)
	(text "Generic 4-pin module (GND VCC SCL SDA), I2C 0x3C, on-board socket.\nModule pull-ups (often 4.7k-10k) add in parallel to R8/R10."
		(at 341.63 203.2 0)
		(effects
