	)
	(text "ROUTING - LINK\nU5, U6, D4 at J2, flow-through: J2 pin -> ESD pad -> pass-through pad, no via before the ESD.\nSPI on L1/L4 over GND only (never on the In2 power plane); MOSI/CS matched to SCK, MISO not (DESIGN_NOTES §7)."
		(at 152.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
				(color 255 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "87426cc5-e95e-487d-98dc-909e98d4ca13")
	)
