	(text "R36/R37 + R40: AUTO ~3.55 V fall / 3.88 V rise (VREF 1.00 V)\nonly with 3.3 V ST bias. VREF tolerance is +/-8%: fall 3.24-3.86 V."
		(at 243.84 129.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2d5a78a8-7c47-406d-8bcd-09b57c1ef056")
	)
	(text "D2: BZX384-C10 gate clamp; characterize transients.\n10 V rating is tested at 5 mA, not the R35 bias current."
		(at 102.87 130.81 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3f645bfe-4208-4102-9135-acccdc38c25a")
	)
	(text "5V INPUT: Q1 REVERSE POLARITY, D3 TVS, F5 FUSE"
		(at 100.33 77.47 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
				(color 0 0 132 1)
			)
			(justify left bottom)
		)
		(uuid "6738b783-17f0-48dd-bb51-6533582e197d")
	)
	(text "PROTECTION LIMITS: TVS0500 clamps up to 9.2 V at 43 A.\nThis is NOT proof of protection for 6 V-absolute-max TPS2116 or 3V3 loads.\nPTCs are thermal devices, not fast current limits; verify fault coordination.\nSources: TVS0500, TPS2116 absolute ratings, MF-MSMF / 1812L."
		(at 223.52 248.92 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "7cf2295f-503d-4661-a083-890e676ddccb")
	)
