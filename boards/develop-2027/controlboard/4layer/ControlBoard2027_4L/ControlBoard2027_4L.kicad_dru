(version 1)

# Stackup: JLC04161H-3313, 1.6 mm, 4 layers (4-layer alternative of ControlBoard2027_6L). L1 F.Cu and L4 B.Cu are
# microstrip over 0.0994 mm 3313 prepreg (er 4.1): F.Cu to the L2 GND plane, B.Cu to L3 (power plane with GND regions
# under every fast B.Cu run). Widths as on the 6-layer board (same prepreg; confirm with the JLC impedance calculator):
#   USB 2.0 90 ohm differential: 0.13 mm width / 0.11 mm gap on F.Cu.
#   50 ohm single-ended: 0.14 mm on F.Cu / B.Cu.
# Pour clearances are scoped to the outer layers (layer outer) so via antipads in the inner planes keep their size.

(rule "USB diff pair geometry"
	(condition "A.NetName == '/MCU/USB_DP' || A.NetName == '/MCU/USB_DM' || A.NetName == '/USB and Debug/USB_DP_CON' || A.NetName == '/USB and Debug/USB_DM_CON'")
	(constraint track_width (min 0.11mm) (opt 0.13mm))
	(constraint diff_pair_gap (min 0.1mm) (opt 0.11mm)))

(rule "SIG50 width on the outer layers"
	(layer outer)
	(condition "A.NetClass == 'SIG50'")
	(constraint track_width (min 0.12mm) (opt 0.14mm)))

# Same-layer pours stay >= 2W from impedance-controlled lines so they stay microstrip (CLAUDE.md section 4).
(rule "USB pour clearance"
	(layer outer)
	(condition "(A.NetName == '/MCU/USB_DP' || A.NetName == '/MCU/USB_DM' || A.NetName == '/USB and Debug/USB_DP_CON' || A.NetName == '/USB and Debug/USB_DM_CON') && B.Type == 'Zone'")
	(constraint clearance (min 0.26mm)))

(rule "SIG50 pour clearance"
	(layer outer)
	(condition "A.NetClass == 'SIG50' && B.Type == 'Zone'")
	(constraint clearance (min 0.28mm)))

# Tactile switch GND pins (SW1, SW2, SW4-SW6): one B.Cu thermal spoke is enough for these THT pins.
(rule "Switch GND pins: one B.Cu spoke"
	(layer B.Cu)
	(condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('SW1') || A.memberOfFootprint('SW2') || A.memberOfFootprint('SW4') || A.memberOfFootprint('SW5') || A.memberOfFootprint('SW6'))")
	(constraint min_resolved_spokes 1))
