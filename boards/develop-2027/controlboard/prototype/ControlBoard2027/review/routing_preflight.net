		(comp
			(ref "J13")
			(value "OLED_Adafruit_326")
			(footprint "ControlBoard2027:Adafruit_326_0p96in_STEMMA_QT_Header")
			(description "Adafruit 326, STEMMA QT version (I2C default, on-board APX803 reset, so pin 4 RST is NC). Same pin numbering as v2.1 but the header is rotated 180 degrees and the holes differ: build J13/H1-H4 from the STEMMA QT board file. Powered from +3V3, its 10k pull-ups sit at 3V3. DC/SA0 grounded -> 0x3C; SA0 goes through a diode, so firmware also probes 0x3D.")
			(fields
				(field
					(name "Footprint_Source") "https://github.com/adafruit/Adafruit-128x64-Monochrome-OLED-PCB, Adafruit 0.96in 128x64 OLED STEMMA QT.brd, JP2 1X08_ROUND_70")
				(field
					(name "Footprint") "ControlBoard2027:Adafruit_326_0p96in_STEMMA_QT_Header")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Adafruit 326, STEMMA QT version (I2C default, on-board APX803 reset, so pin 4 RST is NC). Same pin numbering as v2.1 but the header is rotated 180 degrees and the holes differ: build J13/H1-H4 from the STEMMA QT board file. Powered from +3V3, its 10k pull-ups sit at 3V3. DC/SA0 grounded -> 0x3C; SA0 goes through a diode, so firmware also probes 0x3D.")
			)
