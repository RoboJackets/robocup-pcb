	(text "R_{SMALL} = 94.0 * V_{DDIO} - 100 (kOhms)\nR_{LARGE} = 222.2 * V_{DDIO} - 100 (kOhms)\n\n~{SD_MODE}:\n	High: Left Channel\n	R_{SMALL} Pullup: Right Channel\n	R_{LARGE} Pullup: Left/2 + Right/2\n	Low: Shutdown\n\n3.3V: R_{SMALL} ~= 210kOhm\n3.3V: R_{LARGE} ~= 634kOhm"
		(exclude_from_sim no)
		(at 25.908 34.798 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cf20d0f8-16d9-4185-8720-db7130cea3ea")
	)
	(text "Speaker and Filtering"
		(exclude_from_sim no)
		(at 137.414 20.066 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d2c73104-0d63-4a56-8cd0-2661d4d09970")
	)
	(text "Gain:\n	GND + 100kOhm: 15dB\n	GND: 12 dB\n	Floating: 9dB\n	V_{DD}: 6dB\n	V_{DD} + 100kOhm: 3dB\n\nLeft unpopulated to decide as needed\n!!Not recommended to use greater than 9dB!!"
		(exclude_from_sim no)
		(at 40.894 173.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e1bcd96d-32d2-417d-bf9d-2b7361d9ef30")
	)
