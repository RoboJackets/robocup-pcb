		(uuid "e5bb9936-4908-4e84-bf1b-a63c983c5d83")
	)
	(text "We use a switching regulator for +BATT to 3.3V \nbecause the LDOs are much less efficient than\nswitching regulators for this voltage difference.\n(≈16.5% vs >80% for 20V +BATT)\n\nHowever, LDOs are acceptable for 5V to 3.3V\nstep-down because this rail is only used for\ndebugging and LDOs are far more efficient at\nthis voltage drop (≈66%)."
		(exclude_from_sim no)
		(at 165.1 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e9a27ec6-308f-496e-bb73-6892f744b6ba")
	)
