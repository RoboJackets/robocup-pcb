	)
	(text "This PFET configuration is\ntypical of a reverse polarity\nprotection circuit. It isn't\nbroken. There are a few\nblogs/videos on this just\nsearch \"PFET reverse\npolarity protection\"."
		(exclude_from_sim no)
		(at 85.09 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6ee5b34b-eada-4d3f-906f-638a5d65dbcf")
	)
	(text "NOTE: Spec fuse based on the\nreverse current protection FET\nand diode on this sheet as well\nas the max switching current\nof Q1, T1, and D1 on the LT3751\nsheet. The LT3751 current sense\nresistors should be set to limit\ncurrent below the limit of the fuse."
		(exclude_from_sim no)
		(at 20.066 83.566 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "717681d9-4415-4b9a-9501-bc3fc87b1861")
	)
	(text "Use 15 A"
