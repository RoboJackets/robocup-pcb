	(text "Most components are 50A rated\nEXCEPT the fuse holder and the DA2034 inductor.\nThe inductor is rated for continuous operation\nof 10A, however the current design of the board\ndoes not operate at continuous current."
		(exclude_from_sim no)
		(at 20.066 65.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0af93e6f-e708-4184-ab8e-880e7bd7fdbe")
	)
	(text "3.3V 1A Low-Dropout Regulator (USB only)"
		(exclude_from_sim no)
		(at 217.17 69.088 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0d8cbe36-9a2e-44f5-b93d-9691a71d6242")
	)
	(text "Reverse polarity prot. not needed.\nIf USB power is flipped you have bigger problems."
