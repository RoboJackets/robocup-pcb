	(text "5.1k pull-down on CC1/2\ngenerally makes sure\nthe host gives AT LEAST\n500 mA if USB 2+ compliant."
		(exclude_from_sim no)
		(at 50.546 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
